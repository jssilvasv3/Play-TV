# Copia este ficheiro para .env e preenche os valores.
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)

PLAYLIST_URL=https://iptv-org.github.io/iptv/countries/pt.m3u

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=playtv-thumbs
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev

THUMB_INTERVAL_MIN=60
THUMB_CONCURRENCY=3
THUMB_WIDTH=320
