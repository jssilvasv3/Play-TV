        "radius": "4px",
        "padding": "14px 32px",
        "height": "52px",
        "font": "buttonLg"
      },
      "rent": {
        "background": "#1a242f",
        "color": "#ffffff",
        "border": "1px solid #1399ff",
        "radius": "4px",
        "padding": "10px 20px"
      }
    },
    "card": {
      "poster": {
        "background": "#1a242f",
        "color": "#ffffff",
        "radius": "4px",
        "aspectRatio": "16:9"
      }
    }
