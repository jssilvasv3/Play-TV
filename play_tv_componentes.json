{
  "name": "Prime Video",
  "version": "1.0",
  "colors": {
    "background": {
      "primary": "#0f171e",
      "deep": "#000000",
      "surface": "#1a242f",
      "surfaceStrong": "#232f3e",
      "surfaceSoft": "#0a1117",
      "surfaceCard": "#1a242f",
      "overlay": "rgba(15,23,30,0.85)"
    },
    "text": {
